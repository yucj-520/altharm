&CONTROL
  calculation = 'scf'
  prefix      = 'AB'
  outdir      = './tmp'
  pseudo_dir = '/scratch/work/yuc11/pseudopotentials'
! verbosity   = 'high'
! tprnfor     = .true.
! tstress     = .true.
/

&SYSTEM
  ibrav       = 0
  nat         = 10
  ntyp        = 4
  input_dft   = 'PBE'
  ecutwfc     = 60
  ecutrho     = 240

  nspin       = 2
  starting_magnetization(1) =  1.00   ! CrU, from VASP MAGMOM +4
  starting_magnetization(2) = -1.00   ! CrD, from VASP MAGMOM -4
  starting_magnetization(3) =  0.00   ! Se
  starting_magnetization(4) =  0.00   ! As

  occupations = 'smearing'
  smearing    = 'gaussian'
  degauss     = 0.0150

/

&ELECTRONS
  conv_thr         = 1.0d-10
  electron_maxstep = 200
  mixing_beta      = 0.10
  diagonalization  = 'david'
/

ATOMIC_SPECIES
  CrU   51.9961   cr_pbe_v1.5.uspp.F.UPF
  CrD   51.9961   cr_pbe_v1.5.uspp.F.UPF
  Se    78.9710   Se_pbe_v1.uspp.F.UPF
  As    74.9216   As.pbe-n-rrkjus_psl.0.2.UPF

CELL_PARAMETERS angstrom
        3.7258396285        0.0000002055        0.0000000080
       -1.8629196361        3.2266718606       -0.0000000204
        0.0000000476       -0.0000000907       16.9179784926

ATOMIC_POSITIONS crystal
  CrU      0.333333333100    0.666666671399    0.589599353329
  CrD      0.333333334000    0.666666661900    0.410372928727
  CrD      0.666666665100    0.333333340500    0.089639650738
  CrU      0.666666670300    0.333333339804    0.910509481605
  Se      -0.000000000000   -0.000000000000    0.333226153371
  Se      -0.000000000000   -0.000000000001    0.666734469566
  Se       0.333333324500    0.666666687700    0.833397833845
  Se       0.333333315400    0.666666691397    0.166482726063
  As       0.666666698000    0.333333298200    0.499998219575
  As       0.000000000000    0.000000000001    0.000039605880

K_POINTS automatic
  12 12 4  0 0 0

HUBBARD (ortho-atomic)
  U CrU-3d 3.0
  U CrD-3d 3.0

